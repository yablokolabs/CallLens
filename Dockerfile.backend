FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Audio/ML-native wheels occasionally need build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY packages/calllens/src/ packages/calllens/src/
COPY rubrics/ rubrics/

RUN pip install --upgrade pip \
    && pip install -e ".[postgres]"

EXPOSE 8000

CMD ["uvicorn", "calllens.api:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
