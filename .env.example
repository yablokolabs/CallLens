# ── Speech provider (ElevenLabs) ──────────────────────────────────────
# Get a key at https://elevenlabs.io — never commit real values.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_TTS_VOICE_ID=

# ── Reasoning LLM provider ────────────────────────────────────────────
# Supported: mock | openai | anthropic | compatible (OpenAI-compatible) | bedrock
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# For OpenAI-compatible endpoints (e.g. Ollama, vLLM, LM Studio)
COMPATIBLE_BASE_URL=
COMPATIBLE_API_KEY=
# For Amazon Bedrock (Strands uses BedrockModel; this project auto-switches
# the agent model when MODEL_PROVIDER=bedrock — no AWS migration required)
MODEL_PROVIDER=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=
# e.g. BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ── Analysis pipeline ─────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.75
MAX_RESCORE_ATTEMPTS=2
LANGGRAPH_CHECKPOINT=true

# ── Database ──────────────────────────────────────────────────────────
# Local dev (docker compose) uses Postgres; unit tests default to SQLite.
DATABASE_URL=postgresql+asyncpg://calllens:calllens@localhost:5432/calllens

# ── Coach (Strands agent) ───────────────────────────────────────────
# Powered by strands-agents-sdk · ai-agents · agentic-ai · human-in-the-loop · explainable-ai
DEMO_MODE=false
COACH_MODEL_PROVIDER=
COACH_MODEL_ID=
# Coach uses the same LLM_PROVIDER fallback unless COACH_MODEL_* is set.
# For Bedrock coaching decisions set COACH_MODEL_PROVIDER=bedrock (or
# MODEL_PROVIDER=bedrock) with AWS_* / BEDROCK_MODEL_ID above.

# ── App ───────────────────────────────────────────────────────────────
CALLS_ANALYZE_SYNC=false
LOG_LEVEL=INFO

# ── Frontend (apps/web/.env.local) ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
